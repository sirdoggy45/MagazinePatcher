<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>MagazinePatcher</AssemblyName>
        <AssemblyTitle>MagazinePatcher</AssemblyTitle>
    </PropertyGroup>

    <!-- Probably don't need to touch these -->
    <PropertyGroup>
        <TargetFramework>net35</TargetFramework>
        <Nullable>disable</Nullable>
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsPackable>false</IsPackable>
        <PlatformTarget>x64</PlatformTarget>
        <Optimize>true</Optimize>
        <DebugSymbols>false</DebugSymbols>
        <DebugType>None</DebugType>
        <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    </PropertyGroup>

    <!-- Debug configuration overrides -->
    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <Optimize>false</Optimize>
        <DefineConstants>DEBUG;</DefineConstants>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>full</DebugType>
    </PropertyGroup>

    <PropertyGroup>
        <RootNamespace>$(AssemblyName)</RootNamespace>
        <RestoreAdditionalProjectSources>
            https://nuget.bepinex.dev/v3/index.json;

            <!-- Required for UnityEngine.Core (a Stratum dependency) -->
            https://pkgs.dev.azure.com/bepinex/BepInEx/_packaging/BepInExLibs/nuget/v3/index.json;
        </RestoreAdditionalProjectSources>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>

    <!-- Project references -->
    <ItemGroup>
        <!-- Required to compile .NET Framerowk 3.5 libraries -->
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net35" Version="1.0.3">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>

        <PackageReference Include="UnityEngine" Version="5.6.1"/>
        <PackageReference Include="BepInEx.Core" Version="5.4.17"/>
        <PackageReference Include="H3VR.GameLibs" Version="0.120.22"/>
        <PackageReference Include="Sodalite" Version="1.4.1"/>
        <PackageReference Include="Sodalite.Patcher" Version="1.4.0"/>
        <PackageReference Include="Stratum" Version="1.1.0"/>

        <Reference Include="OtherLoader">
            <HintPath>..\libs\OtherLoader.dll</HintPath>
        </Reference>
    </ItemGroup>

    <!-- Change this path locally after cloning the project -->
    <!-- Use "Browse profile folder" option in r2modman settings to find where the plugin is installed -->
    <PropertyGroup>
        <PluginOutputDir>
            E:\Software\.ProgramData\r2modmanPlus-local\H3VR\profiles\ModdingProfile\BepInEx\plugins\ODekaK-MagazinePatcher\MagazinePatcher
        </PluginOutputDir>
    </PropertyGroup>

    <Target Name="MoveDllToPluginDir" AfterTargets="PostBuildEvent" Condition="'$(Configuration)' == 'Debug'">
        <Copy SourceFiles="$(ProjectDir)$(OutDir)$(AssemblyName).dll" DestinationFolder="$(PluginOutputDir)"/>
    </Target>

    <!-- The 'clean' command won't cleanup stuff we make so do that here -->
    <Target Name="CleanAdditionalStuff" AfterTargets="Clean">
        <Delete Files="$(ProjectDir)$(OutDir)$(AssemblyName).dll.mdb"/>
        <Delete Files="$(ProjectDir)$(OutDir)$(AssemblyName).zip"/>
    </Target>
</Project>